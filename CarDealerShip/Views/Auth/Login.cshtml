@model CarDealerShip.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}


<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

<div class="row justify-content-center align-items-center py-5" style="min-height: 75vh;">
    <div class="col-12 col-sm-9 col-md-7 col-lg-5 col-xl-4">
        <div class="card shadow-lg border-0">
            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-3">
                    <i class="bi bi-car-front-fill fs-1 text-primary"></i>
                    <h1 class="h4 fw-bold mt-2 mb-1">車行後臺管理系統</h1>
                    <h4 class="h6 text-muted fw-normal">請先登入</h4>
                </div>
                <hr class="mb-4" />

                <form asp-action="Login">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Email" class="control-label form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Password" class="control-label form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" class="form-control" />
                            <button class="btn btn-outline-secondary" type="button" id="btnTogglePwd">
                                <i class="bi bi-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <input type="submit" value="Login" class="btn btn-primary w-100 py-2 fw-bold" />
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            //切換密碼顯示與隱藏
            $('#btnTogglePwd').on('click', function ()
            {
                const pwdInput = $('#Password');
                const eyeIcon = $('#eyeIcon');

                if (pwdInput.attr('type') === 'password')
                {
                    pwdInput.attr('type', 'text');
                    eyeIcon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
                else
                {
                    pwdInput.attr('type', 'password');
                    eyeIcon.removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });
        });
    </script>
}
