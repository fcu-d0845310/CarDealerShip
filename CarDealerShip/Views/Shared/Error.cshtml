@model CarDealerShip.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "發生錯誤";
}

<div class="text-center py-5">
    <div class="display-6 text-secondary mb-3"><i class="bi bi-exclamation-circle"></i></div>
    <h1 class="h4 fw-bold mb-2">系統發生錯誤</h1>
    <p class="text-secondary mb-4">處理您的要求時發生問題，請稍後再試。</p>

    @*只顯示追蹤編號，方便對照伺服器日誌*@
    @if (Model.ShowRequestId)
    {
        <p class="small text-secondary mb-4">追蹤編號：<code>@Model.RequestId</code></p>
    }

    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-dark px-4">回到首頁</a>
</div>
