@model CarDealerShip.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    int totalCars = Model.CarCount.Values.Sum();
    int Percent(int count) => totalCars == 0 ? 0 : (int)Math.Round(count * 100.0 / totalCars);
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

<style>
    /*灰底色、hover 效果 */
    .tile {
        background: #f4f4f5;
        min-height: 150px;
        transition: background .25s;
    }

        .tile:hover {
            background: #e4e4e7;
        }

        .tile .go {
            opacity: .35;
            transition: .25s;
        }

        .tile:hover .go {
            opacity: 1;
            transform: translate(2px, -2px);
        }
</style>

<h1 class="h4 fw-bold mb-3">車行總覽</h1>

<!-- 第一排：左邊車輛大卡，右邊（銷售額 + 出價 + 收購） -->
<div class="row g-3 mb-3">

    <!-- 車輛庫存 -->
    <div class="col-12 col-lg-6">
        <a class="d-block h-100 text-decoration-none text-reset" asp-controller="Car" asp-action="Index">
            <div class="tile rounded-4 p-4 h-100">
                <div class="d-flex align-items-center small text-secondary">
                    <i class="bi bi-car-front me-2"></i>車輛庫存
                    <i class="bi bi-arrow-up-right go ms-auto"></i>
                </div>
                <div class="fs-2 fw-bold text-dark mt-2 mb-3">@totalCars 台</div>

                @if (Model.CarCount.Count == 0)
                {
                    <div class="small text-muted">尚無分店資料</div>
                }
                else
                {
                    @foreach (var branch in Model.CarCount.OrderByDescending(x => x.Value))
                    {
                        <div class="d-flex small text-secondary mb-1">
                            <span>@branch.Key</span>
                            <span class="ms-auto">@branch.Value</span>
                        </div>
                        <div class="progress mb-3" style="height: 6px;">
                            <div class="progress-bar bg-secondary" style="width: @(Percent(branch.Value))%"></div>
                        </div>
                    }
                }
            </div>
        </a>
    </div>

    <!-- 右半邊：巢狀 row -->
    <div class="col-12 col-lg-6">
        <div class="row g-3 h-100">

            <!-- 本月銷售額 -->
            <div class="col-12">
                <a class="d-block h-100 text-decoration-none text-reset" asp-controller="SalesRecord" asp-action="Index">
                    <div class="tile rounded-4 p-4 h-100">
                        <div class="d-flex align-items-center small text-secondary">
                            <i class="bi bi-graph-up me-2"></i>本月銷售額
                            <i class="bi bi-arrow-up-right go ms-auto"></i>
                        </div>
                        <div class="fs-2 fw-bold text-dark mt-2">NT$ @Model.MonthSale.ToString("N0")</div>
                    </div>
                </a>
            </div>

            <!-- 出價 -->
            <div class="col-6">
                <a class="d-block h-100 text-decoration-none text-reset" asp-controller="Offer" asp-action="Index">
                    <div class="tile rounded-4 p-4 h-100">
                        <div class="d-flex align-items-center small text-secondary">
                            <i class="bi bi-cash-coin me-2"></i>出價
                            <i class="bi bi-arrow-up-right go ms-auto"></i>
                        </div>
                        <div class="fs-2 fw-bold text-dark mt-2">@Model.OfferCount</div>
                    </div>
                </a>
            </div>

            <!-- 收購申請 -->
            <div class="col-6">
                <a class="d-block h-100 text-decoration-none text-reset" asp-controller="TradeIn" asp-action="Index">
                    <div class="tile rounded-4 p-4 h-100">
                        <div class="d-flex align-items-center small text-secondary">
                            <i class="bi bi-arrow-left-right me-2"></i>收購申請
                            <i class="bi bi-arrow-up-right go ms-auto"></i>
                        </div>
                        <div class="fs-2 fw-bold text-dark mt-2">@Model.TradeInCount</div>
                    </div>
                </a>
            </div>

        </div>
    </div>
</div>

<!-- 第二排-->
<div class="row g-3">

    <!-- 訂單 -->
    <div class="col-6 col-lg-3">
        <a class="d-block h-100 text-decoration-none text-reset" asp-controller="Order" asp-action="Index">
            <div class="tile rounded-4 p-4 h-100">
                <div class="d-flex align-items-center small text-secondary">
                    <i class="bi bi-receipt me-2"></i>訂單
                    <i class="bi bi-arrow-up-right go ms-auto"></i>
                </div>
                <div class="fs-2 fw-bold text-dark mt-2">@Model.OrderCount</div>
            </div>
        </a>
    </div>

    <!-- 預約 -->
    <div class="col-6 col-lg-3">
        <a class="d-block h-100 text-decoration-none text-reset" asp-controller="Reservation" asp-action="Index">
            <div class="tile rounded-4 p-4 h-100">
                <div class="d-flex align-items-center small text-secondary">
                    <i class="bi bi-calendar-check me-2"></i>預約
                    <i class="bi bi-arrow-up-right go ms-auto"></i>
                </div>
                <div class="fs-2 fw-bold text-dark mt-2">@Model.ReservationCount</div>
            </div>
        </a>
    </div>

    <!-- 文章 / 留言 -->
    <div class="col-12 col-lg-6">
        <a class="d-block h-100 text-decoration-none text-reset" asp-controller="Post" asp-action="Index">
            <div class="tile rounded-4 p-4 h-100">
                <div class="d-flex align-items-center small text-secondary">
                    <i class="bi bi-chat-square-text me-2"></i>文章 / 留言
                    <i class="bi bi-arrow-up-right go ms-auto"></i>
                </div>
                <div class="fs-2 fw-bold text-dark mt-2">@Model.PostCount</div>
            </div>
        </a>
    </div>

</div>
